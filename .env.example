############################################
# Environment
############################################
# "development" enables test_token auth bypass and debug logging
ENVIRONMENT=development
LOG_LEVEL=INFO

############################################
# FastAPI
############################################

HOST=0.0.0.0
PORT=8000

############################################
# JWT Authentication
############################################
# REQUIRED — used to sign/verify all JWT tokens
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

############################################
# OpenClaw Gateway
############################################
# OPENCLAW_GATEWAY_TOKEN must match the value used in openclaw.json
# (openclaw.json references it via ${OPENCLAW_GATEWAY_TOKEN})
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=change_me
OPENCLAW_MODEL=openclaw
OPENCLAW_AGENT_ID=main
OPENCLAW_REQUEST_TIMEOUT=120

############################################
# Redis
############################################

REDIS_URL=redis://redis:6379/0

############################################
# PostgreSQL
############################################
# REQUIRED — used by all database services (orders, compliance, sanctions, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/alfred_dev

# Used by services/trade_prevention_service.py, sanctions_service.py, etc.
NEON_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/alfred_dev

############################################
# AWS (required by Redis-Gateway cloud_storage)
############################################

AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-east-1
AWS_S3_BUCKET_NAME=clax-beta-artifacts

############################################
# ML Services
############################################

OPTIMAL_ENTRY_URL=http://localhost:8001
TOP10_MONTHLY_PICKS_URL=http://localhost:8002
PORTFOLIO_REBALANCING_URL=http://localhost:8003

############################################
# Feature Flags
############################################

ENABLE_PII_MASKING=true
ENABLE_OPENCLAW_GATEWAY=true
ENABLE_STREAMING=false

############################################
# CORS
############################################

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
