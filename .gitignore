# ===========================================
agents/main/sessions/sessions.json
tasks/*.sqlite*
tasks/*.sqlite-shm
tasks/*.sqlite-wal
logs/
*.bak
update-check.json
workspace/.openclaw/
canvas/index.html
completions/

