# CLAX Filing Intelligence Environment Configuration

# Neon Postgres Database URL (SSL required)
# Example: DATABASE_URL="postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require"
DATABASE_URL=

# SEC EDGAR Mandatory User-Agent Identity Header
# SEC requires Name and Email address in User-Agent header
# Example: EDGAR_IDENTITY=" CLAX_FIE admin@clax-fie.com"
EDGAR_IDENTITY=

# Local Swappable Object Store Path
RAW_OBJECT_STORE_PATH="./data/raw_object_store"

# Alpaca API Credentials (for company universe listing)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL="https://paper-api.alpaca.markets"
MAX_COMPANIES=5

